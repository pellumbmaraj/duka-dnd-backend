# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
# Use your exact frontend origin(s); comma-separated if needed.
METRO_FRONTEND_ORIGINS=http://localhost:3000
# Keep the database outside source control and restrict filesystem access.
METRO_DATABASE=instance/metro.sqlite3

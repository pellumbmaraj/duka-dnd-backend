# Copy this file to .env and replace the value with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=replace-this-with-a-generated-random-secret
# Use your exact frontend origin(s); comma-separated if needed.
METRO_FRONTEND_ORIGINS=http://localhost:3000
# Keep the database outside source control and restrict filesystem access.
METRO_DATABASE=instance/metro.sqlite3
# Use production only when the app is served over HTTPS.
METRO_ENV=development
# Public URL used in activation emails.
FRONTEND_PUBLIC_URL=http://localhost:3000
# SMTP connection used for client activation emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
MAIL_FROM=accounts@dukagroup.al
MAIL_FROM_NAME=DUKA Group
# OTP expiry window.
ACTIVATION_OTP_MINUTES=30
# Operational portal accounts. Generate unique passwords for each deployment.
PACKING_STAFF_EMAIL=packing@dukagroup.al
PACKING_STAFF_PASSWORD=replace-with-a-long-random-password
DELIVERY_STAFF_EMAIL=delivery@dukagroup.al
DELIVERY_STAFF_PASSWORD=replace-with-a-different-long-random-password
